# Tecto Mark — Service Inquiry Server Configuration

# Server Port
PORT=3000

# Recipient Email for Team Alerts
ADMIN_EMAIL=tectomarksupport@gmail.com

# Optional: Admin Secret Key for viewing /api/inquiries
ADMIN_KEY=tectomark-secret-key

# Transactional Email Configuration
# Option A: Standard SMTP (Gmail, Brevo, SendGrid, Amazon SES, Mailgun, etc.)
# If using Gmail: Use an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tectomarksupport@gmail.com
SMTP_PASS=your-app-password-here
EMAIL_FROM="Tecto Mark <tectomarksupport@gmail.com>"

# Option B: Resend API (Alternative)
# RESEND_API_KEY=re_your_api_key_here
